{
  "ConnectionStrings": {
    "SqlServer": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "PgPassthrough": "Server=YOUR_SERVER,YOUR_PORT;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=False"
  },
  "ActiveConnection": "SqlServer",
  "Validation": {
    "StopOnFirstFailure": false,
    "TimeoutSeconds": 30,
    "VerboseOutput": false
  }
}
