  "datePatterns": [
    {
      "sqlServerFunction": "DATEDIFF",
      "argCount": 3,
      "description": "DATEDIFF(datepart, startdate, enddate) → date subtraction with EXTRACT",
      "partMappings": {
        "YEAR": "EXTRACT(YEAR FROM {2}) - EXTRACT(YEAR FROM {1})",
        "QUARTER": "(EXTRACT(YEAR FROM {2}) * 4 + EXTRACT(QUARTER FROM {2})) - (EXTRACT(YEAR FROM {1}) * 4 + EXTRACT(QUARTER FROM {1}))",
        "MONTH": "(EXTRACT(YEAR FROM {2}) - EXTRACT(YEAR FROM {1})) * 12 + EXTRACT(MONTH FROM {2}) - EXTRACT(MONTH FROM {1})",
        "DAY": "EXTRACT(DAY FROM ({2}::timestamp - {1}::timestamp))",
        "HOUR": "EXTRACT(EPOCH FROM ({2}::timestamp - {1}::timestamp)) / 3600",
        "MINUTE": "EXTRACT(EPOCH FROM ({2}::timestamp - {1}::timestamp)) / 60",
        "SECOND": "EXTRACT(EPOCH FROM ({2}::timestamp - {1}::timestamp))",
        "WEEK": "EXTRACT(DAY FROM ({2}::timestamp - {1}::timestamp)) / 7"
      }
    },
