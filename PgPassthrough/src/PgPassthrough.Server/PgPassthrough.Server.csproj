<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.*.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PgPassthrough.Core\PgPassthrough.Core.csproj" />
    <ProjectReference Include="..\PgPassthrough.Tds\PgPassthrough.Tds.csproj" />
    <ProjectReference Include="..\PgPassthrough.SqlParser\PgPassthrough.SqlParser.csproj" />
    <ProjectReference Include="..\PgPassthrough.Translation\PgPassthrough.Translation.csproj" />
    <ProjectReference Include="..\PgPassthrough.Execution\PgPassthrough.Execution.csproj" />
    <ProjectReference Include="..\PgPassthrough.Results\PgPassthrough.Results.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

</Project>
